    "@nemesis-oss/market-research": "file:vendor/market-research",
    "@nemesis-oss/market-research-agent": "file:vendor/research-agent",
    "@nemesis-oss/market-stream": "file:vendor/market-stream",
    "@nemesis-oss/market-state": "file:vendor/market-state",
    "@nemesis-oss/regime-engine": "file:vendor/regime-engine",
    "@nemesis-oss/market-features": "file:vendor/market-features",
