# Ollama API Configuration
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=gemma4:cloud

# Trading Environment
TRADING_ENV=paper
PORT=3002

# Execution venue: paper (default, in-process simulator) | coindcx (live keys required)
EXECUTION_VENUE=paper
COINDCX_API_KEY=
COINDCX_API_SECRET=
# USDT | INR | auto (auto prefers USDT-margined, falls back to INR with live USDTINR FX)
COINDCX_QUOTE_PREFERENCE=auto
PAPER_INITIAL_FUTURES_BALANCE=10000

# Prop-firm risk envelope (kernel defaults; override here)
RISK_MAX_PER_TRADE_PCT=0.25
RISK_MAX_DAILY_LOSS_PCT=1.0
RISK_MAX_DRAWDOWN_PCT=5.0
RISK_MAX_LEVERAGE=2
RISK_MIN_RR=2.5
RISK_MAX_POSITIONS=2
RISK_MAX_NOTIONAL=250000
RISK_MAX_LOSS_STREAK=3
RISK_CHALLENGER_ENABLED=true

# Kernel runtime
KERNEL_SYMBOLS=BTCUSDT,SOLUSDT
KERNEL_SCAN_INTERVAL_MS=300000
RECONCILE_INTERVAL_MS=15000
EVENT_STORE_PATH=.data
LOG_LEVEL=info
KERNEL_TOOLS=true
